{
	"name": "wemail",
	"version": "1.1.4",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"main": "dist-electron/electron/main/app.js",
	"imports": {
		"#edition-modules": "./dist-electron/server/wemail/bootstrap/editionModules.noop.js"
	},
	"build": {
		"appId": "com.wemail.app",
		"productName": "WeMail",
		"artifactName": "${productName}-${version}-${arch}.${ext}",
		"files": [
			"dist-electron/**/*",
			"build/**/*",
			"package.json",
			"!**/*.map",
			"!**/*.test.js",
			"!**/*.test.ts",
			"!**/*.test.tsx",
			"!tests/**",
			"!openspec/**",
			"!docs/**",
			"!scripts/**",
			"!docker/**"
		],
		"extraResources": [
			{
				"from": "electron/assets",
				"to": "assets"
			},
			{
				"from": "build/free-trial-config.json",
				"to": "free-trial-config.json"
			},
			{
				"from": "skills/builtin",
				"to": "skills/builtin"
			},
			{
				"from": "automation-templates/builtin",
				"to": "automation-templates/builtin"
			},
			{
				"from": "build/edition",
				"to": "edition"
			}
		],
		"extraFiles": [
			{
				"from": "packaging/windows/install-wemail-certificate.cmd",
				"to": "install-wemail-certificate.cmd"
			}
		],
		"asarUnpack": [
			"**/*.node"
		],
		"win": {
			"executableName": "WeMailDesktop",
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "packaging/icon.ico"
		},
		"nsis": {
			"include": "packaging/nsis/install-update-trust.nsh",
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": false,
			"shortcutName": "WeMail",
			"installerIcon": "packaging/icon.ico",
			"uninstallerIcon": "packaging/icon.ico",
			"installerHeaderIcon": "packaging/icon.ico",
			"deleteAppDataOnUninstall": false
		}
	},
	"scripts": {
		"postinstall": "node scripts/patch-pi-skill-exports.mjs && (node scripts/ensure-electron-native-bindings.mjs || echo \"[wemail] better-sqlite3 Electron 绑定重建失败，桌面启动前请运行 npm run ensure:desktop-native\")",
		"build": "react-router build",
		"build:website": "npm --prefix website run build",
		"dev": "react-router dev",
		"dev:renderer": "react-router dev --host 127.0.0.1 --port 5173 --strictPort",
		"dev:api": "tsx scripts/dev-api-server.ts",
		"dev:web": "concurrently -k -n api,renderer -c blue,magenta \"npm run dev:api\" \"npm run dev:renderer\"",
		"dev:desktop": "concurrently -k \"npm run dev:renderer\" \"npm run dev:desktop:main\"",
		"dev:desktop:main": "wait-on http://127.0.0.1:5173 && npm run ensure:desktop-native && npm run build:desktop && node scripts/launch-desktop-dev.mjs --no-sandbox dist-electron/electron/main/app.js",
		"dev:desktop:profile": "concurrently -k \"npm run dev:renderer\" \"npm run dev:desktop:main:profile\"",
		"dev:desktop:main:profile": "wait-on http://localhost:5173 && npm run ensure:desktop-native && npm run build:desktop && node scripts/launch-desktop-dev.mjs --wemail-profile --no-sandbox dist-electron/electron/main/app.js",
		"dev:desktop:trace": "concurrently -k \"npm run dev:renderer\" \"npm run dev:desktop:main:trace\"",
		"dev:desktop:main:trace": "wait-on http://localhost:5173 && npm run ensure:desktop-native && npm run build:desktop && node scripts/launch-desktop-dev.mjs --wemail-trace --no-sandbox dist-electron/electron/main/app.js",
		"build:desktop:main:quick": "tsc -p electron/tsconfig.build.json --incremental --tsBuildInfoFile dist-electron/.desktop-quick.tsbuildinfo",
		"dev:renderer:quick": "node scripts/start-desktop-quick-renderer.mjs",
		"desktop:quick:main": "wait-on http://127.0.0.1:5173 && node scripts/launch-desktop-dev.mjs --wemail-debug-mode --no-sandbox dist-electron/electron/main/app.js",
		"desktop:quick": "npm run ensure:desktop-native && npm run build:desktop:main:quick && concurrently -k -n renderer,desktop -c magenta,blue \"npm run dev:renderer:quick\" \"npm run desktop:quick:main\"",
		"desktop:restart": "node scripts/restart-desktop-quick.mjs",
		"reset:demo-data": "node scripts/reset-demo-data.mjs",
		"dev:seed": "tsx scripts/seed-dev-account.ts",
		"configure:desktop-cache": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-desktop-build-cache.ps1",
		"ensure:electron-runtime": "node scripts/ensure-electron-runtime.mjs",
		"ensure:desktop-native": "npm run ensure:electron-runtime && node scripts/ensure-electron-native-bindings.mjs",
		"build:renderer": "node scripts/check-ui-information-boundary.mjs && react-router build && node scripts/check-renderer-bundle-budget.mjs",
		"check:ui-boundaries": "node scripts/check-ui-information-boundary.mjs",
		"check:renderer-bundle": "node scripts/check-renderer-bundle-budget.mjs",
		"check:canonical-mail-schema": "node scripts/check-canonical-mail-schema.mjs",
		"check:public-boundary": "node scripts/check-public-boundary.mjs",
		"build:desktop": "node scripts/clean-desktop-output.mjs && npm run build:renderer && node scripts/write-free-trial-config.mjs && tsx scripts/write-edition-config.ts && tsc -p electron/tsconfig.build.json && tsx scripts/write-update-policy.ts",
		"render:icon": "node scripts/render-wemail-icon.mjs",
		"package:desktop": "npm run package:desktop:unpacked",
		"package:desktop:unpacked": "node scripts/package-desktop-win-dir.mjs",
		"package:desktop:unpacked:from-build": "node scripts/package-desktop-win-dir.mjs --skip-build",
		"package:desktop:dir": "npm run package:desktop:unpacked",
		"package:desktop:dir:from-build": "npm run package:desktop:unpacked:from-build",
		"package:desktop:installer": "npm run package:desktop:unpacked && node scripts/package-desktop-win-dir.mjs --installer-only",
		"package:desktop:installer:from-build": "npm run package:desktop:unpacked:from-build && node scripts/package-desktop-win-dir.mjs --installer-only",
		"test:packaging": "node --test tests/scripts/*.test.mjs",
		"test:edition-identity": "node --test scripts/edition-identity.test.mjs",
		"package:mac": "npm run build:desktop && electron-builder --mac dmg --x64",
		"package:windows": "bash scripts/build-windows.sh",
		"package:release:windows": "node scripts/package-release.mjs win32 x64",
		"certificate:windows:test": "node scripts/windows-test-certificate.mjs",
		"package:windows:self-signed": "node scripts/package-windows-self-signed.mjs",
		"package:windows:self-signed:fast": "node scripts/package-windows-self-signed.mjs --no-compress",
		"package:release:mac:x64": "node scripts/package-release.mjs darwin x64",
		"package:release:mac:arm64": "node scripts/package-release.mjs darwin arm64",
		"ship": "node scripts/ship.mjs",
		"preview": "npm run build && vite preview",
		"test:server": "node scripts/run-server-tests.mjs",
		"test:server:unit": "node scripts/run-server-tests.mjs --scope unit",
		"test:server:integration": "node scripts/run-server-tests.mjs --scope integration",
		"test:server:acceptance": "node scripts/run-server-tests.mjs --scope acceptance",
		"test:server:evaluation": "node scripts/run-server-tests.mjs --scope evaluation",
		"test:server:live": "node scripts/run-server-tests.mjs --scope live",
		"test:renderer": "vitest run",
		"test:renderer:node": "vitest run --project node",
		"test:renderer:dom": "vitest run --project renderer",
		"test:renderer:related": "vitest related --run --passWithNoTests",
		"test:renderer:watch": "vitest",
		"test:website": "npm --prefix website test",
		"test:e2e": "node scripts/run-e2e.mjs",
		"test:e2e:headed": "playwright test --headed",
		"test:browser": "node scripts/run-browser-tests.mjs",
		"test:browser:headed": "node scripts/run-browser-tests.mjs --headed",
		"test:browser:ui": "node scripts/run-browser-tests.mjs --ui",
		"test:midscene": "node scripts/run-midscene-tests.mjs",
		"test:midscene:headed": "node scripts/run-midscene-tests.mjs --headed",
		"test:all": "npm run verify:full",
		"verify:changed": "node scripts/verify-changed.mjs",
		"verify:pr": "npm run check:canonical-mail-schema && npm run check:public-boundary && npm run test:edition-identity && npm run typecheck && npm run typecheck:server && npm run typecheck:desktop && npm run test:server:unit && npm run test:renderer",
		"verify:full": "npm run verify:pr && npm run test:server:integration && npm run test:server:acceptance && npm run test:server:evaluation && npm run build:desktop && npm run test:browser && npm run test:e2e -- --skip-build",
		"typecheck:desktop": "tsc -p electron/tsconfig.json --noEmit",
		"typecheck:server": "tsc -p server/tsconfig.json --noEmit",
		"typecheck": "react-router typegen && tsc -b"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.80.6",
		"@earendil-works/pi-ai": "0.80.6",
		"@earendil-works/pi-coding-agent": "0.80.6",
		"@hono/node-server": "^2.0.0",
		"@larksuiteoapi/node-sdk": "1.71.1",
		"@qwen-code/channel-base": "0.21.1",
		"@qwen-code/channel-feishu": "0.21.1",
		"@qwen-code/channel-wecom": "0.21.1",
		"better-sqlite3": "^12.9.0",
		"echarts": "^6.1.0",
		"electron-updater": "^6.8.3",
		"figlet": "^1.12.0",
		"hono": "^4.7.11",
		"imapflow": "^1.3.2",
		"node-html-markdown": "^2.0.0",
		"node-html-parser": "^6.1.13",
		"nodemailer": "^8.0.5",
		"partial-json": "0.1.7",
		"pinyin-pro": "^3.29.5",
		"sm-crypto": "^0.5.8",
		"pdf-parse": "^2.4.5",
		"postal-mime": "^2.6.1",
		"qrcode": "^1.5.4",
		"sharp": "^0.34.5",
		"yauzl": "^2.10.0",
		"yazl": "^2.5.1",
		"zod": "^3.25.76"
	},
	"overrides": {
		"protobufjs": "7.6.5",
		"@tiptap/core": "3.20.2",
		"@tiptap/pm": "3.20.2",
		"@tiptap/extensions": "3.20.2",
		"@tiptap/extension-blockquote": "3.20.2",
		"@tiptap/extension-bold": "3.20.2",
		"@tiptap/extension-bubble-menu": "3.20.2",
		"@tiptap/extension-bullet-list": "3.20.2",
		"@tiptap/extension-code": "3.20.2",
		"@tiptap/extension-code-block": "3.20.2",
		"@tiptap/extension-document": "3.20.2",
		"@tiptap/extension-dropcursor": "3.20.2",
		"@tiptap/extension-floating-menu": "3.20.2",
		"@tiptap/extension-gapcursor": "3.20.2",
		"@tiptap/extension-hard-break": "3.20.2",
		"@tiptap/extension-heading": "3.20.2",
		"@tiptap/extension-horizontal-rule": "3.20.2",
		"@tiptap/extension-italic": "3.20.2",
		"@tiptap/extension-list": "3.20.2",
		"@tiptap/extension-list-item": "3.20.2",
		"@tiptap/extension-list-keymap": "3.20.2",
		"@tiptap/extension-ordered-list": "3.20.2",
		"@tiptap/extension-paragraph": "3.20.2",
		"@tiptap/extension-strike": "3.20.2",
		"@tiptap/extension-text": "3.20.2"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.0.4",
		"@midscene/web": "^1.7.5",
		"@phosphor-icons/react": "^2.1.10",
		"@playwright/test": "^1.59.1",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@react-router/dev": "^7.5.3",
		"@react-router/node": "^7.5.3",
		"@tailwindcss/vite": "^4.1.4",
		"@tanstack/react-query": "^5.99.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@tiptap/extension-color": "3.20.2",
		"@tiptap/extension-highlight": "3.20.2",
		"@tiptap/extension-image": "3.20.2",
		"@tiptap/extension-link": "3.20.2",
		"@tiptap/extension-text-align": "3.20.2",
		"@tiptap/extension-text-style": "3.20.2",
		"@tiptap/extension-underline": "3.20.2",
		"@tiptap/react": "3.20.2",
		"@tiptap/starter-kit": "3.20.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/dompurify": "^3.0.5",
		"@types/node": "^20.19.37",
		"@types/nodemailer": "^8.0.0",
		"@types/qrcode": "^1.5.5",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@types/yazl": "^2.4.5",
		"@vitejs/plugin-react": "5.2.0",
		"@vitest/ui": "^4.1.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"concurrently": "^9.2.1",
		"dompurify": "^3.3.3",
		"drizzle-orm": "^0.45.1",
		"electron": "41.3.0",
		"electron-builder": "^26.8.1",
		"electron-is-dev": "^3.0.1",
		"isbot": "^5.1.27",
		"jose": "^6.2.1",
		"jsdom": "^29.0.2",
		"node-abi": "^4.28.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-resizable-panels": "4.12.1",
		"react-router": "^7.5.3",
		"sonner": "^2.0.7",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.1.4",
		"tsx": "^4.21.0",
		"typescript": "^5.8.3",
		"vite": "^6.3.3",
		"vite-tsconfig-paths": "^5.1.4",
		"wait-on": "^9.0.5",
		"zustand": "^5.0.12"
	}
}
