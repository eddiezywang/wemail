# Midscene model configuration — copy to `.env.midscene` and fill in.
# Loaded by `tests/midscene/setup.ts` so Playwright tests can talk to
# the same OpenAI-compatible endpoint that Codex uses (i.e. your
# OpenAI account). Keep your real `.env.midscene` untracked.

# Required: API key for an OpenAI-compatible endpoint. Codex uses your
# OpenAI account under the hood — paste the same key here.
MIDSCENE_MODEL_API_KEY=

# Optional: custom base URL (Codex talks to OpenAI by default; override
# only if you proxy through Azure / a self-hosted gateway).
# MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1

# Optional: model name. gpt-4o is Midscene's documented default; gpt-5,
# gpt-4.1, qwen2.5-vl, etc. also work as long as they support vision.
MIDSCENE_MODEL_NAME=gpt-4o

# Optional: declare the model family if it's not auto-detected.
# Useful when pointing at non-OpenAI vendors. Leave empty for OpenAI.
# MIDSCENE_MODEL_FAMILY=

# Optional: enable cache so repeated test runs replay LLM responses.
# MIDSCENE_CACHE=true
