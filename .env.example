# WeMail dev-only env. Copy to `.env.local` and fill what you need.
# `.env.local` is gitignored by `.env.*`; only this `.env.example` is tracked.
#
# All `VITE_*` variables are inlined into the renderer bundle at build time
# (Vite convention). Keep secrets OUT of `VITE_*` keys — anything `VITE_*`
# is shipped to the client.

# ─────────────────────────────────────────────────────────────────────────
# Dev quick-boot: skip the onboarding wizard's welcome + provider steps
# when an account hasn't been created yet on this machine. The renderer
# pre-fills the credentials form with this email and auto-resolves the
# IMAP/SMTP preset from the email domain. You still type the password
# in the UI on first run — passwords intentionally never live in env.
#
# Once a mailbox is connected once, the app boots straight into the
# workbench regardless of this flag (the backend remembers the account).
VITE_DEV_EMAIL=

# Optional: prefilled display name (otherwise defaults to email prefix).
VITE_DEV_DISPLAY_NAME=

# DANGER — DEV ONLY. Vite bakes every `VITE_*` into the renderer bundle
# at build time. The onboarding code reads VITE_DEV_PASSWORD only behind
# `import.meta.env.DEV`, so a production build (`npm run build` / the
# packaged Electron app) DCEs the read and never inlines the value.
# Even so: NEVER ship a production build with `VITE_DEV_PASSWORD` set
# in `.env.local`. Vite will substitute it before tree-shaking decides
# anything, and the literal will sit in `build/client/assets/*.js`.
#
# The expected value is an IMAP/SMTP authorization code (the per-app
# token most providers issue), NOT your real mailbox password.
VITE_DEV_PASSWORD=

# When `1` and all of email + password are set, the renderer auto-clicks
# "连接邮箱" on onboarding mount so a fresh-state dev boot lands in the
# workbench without any UI interaction. Same DEV-only guard applies.
VITE_DEV_AUTOLOGIN=
# Opt-in local MCP server. It always binds to 127.0.0.1.
WEMAIL_MCP_ENABLED=0
WEMAIL_MCP_PORT=43129

# ─────────────────────────────────────────────────────────────────────────
# 限时免费资源 — 客户端侧（打进安装包，仅含签发服务地址 + issuer key）。
# 服务端专用（server/wemail/activation/freeTrialResource.ts）：激活时调用
# 运营签发服务（services/free-trial-issuer）为每个用户幂等签发以用户名
# 为名的限时 API Key。Sub2API 管理凭证只存在于签发服务的服务器环境变量，
# 不进安装包。issuer key 泄露仅能触发签发（签发服务按用户名幂等 + IP 限频）。
# 留空则禁用"限时免费资源"入口（用户仍可手动配置自己的 LLM）。
#
#   WEMAIL_FREE_TRIAL_ISSUER_URL  签发服务地址（部署方自行提供，勿写内网地址）
#   WEMAIL_FREE_TRIAL_ISSUER_KEY  签发服务鉴权密钥
WEMAIL_FREE_TRIAL_ISSUER_URL=
WEMAIL_FREE_TRIAL_ISSUER_KEY=

# 运营签发服务（services/free-trial-issuer）环境变量 — 部署在服务器上，
# 绝不进入安装包：
#   WEMAIL_FREE_TRIAL_ISSUER_KEY / WEMAIL_FREE_TRIAL_ISSUER_PORT
#   WEMAIL_FREE_TRIAL_BASE_URL / WEMAIL_FREE_TRIAL_ADMIN_EMAIL /
#   WEMAIL_FREE_TRIAL_ADMIN_PASSWORD / WEMAIL_FREE_TRIAL_GROUP_ID /
#   WEMAIL_FREE_TRIAL_DAYS / WEMAIL_FREE_TRIAL_MODEL
# Optional desktop telemetry, configured at startup — never baked into builds.
# Telemetry ships disabled: with no endpoint URL set, nothing is collected or
# sent. Operators who want telemetry must set these explicitly.
WEMAIL_TELEMETRY_PRIMARY_URL=
WEMAIL_TELEMETRY_SECONDARY_URL=
WEMAIL_TELEMETRY_SECONDARY_TOKEN=
# AI intelligence worker concurrency (summary/tags/reply-decision jobs).
# Each value is one independent CanonicalAiWorker; claimJob is atomic so they
# never double-dispatch the same job. N workers = N concurrent LLM calls.
# Defaults to 4 for AI summary throughput; body synchronization remains
# single-concurrency. Bounded to [1, 8] in code.
WEMAIL_AI_WORKER_CONCURRENCY=4
# Reply-decision capability master switch. When not "1" the AI worker will not
# claim ai.reply-decision jobs (existing pending ones are preserved, not
# deleted — they resume draining the moment this is set to "1"). The fan-out
# strategy honors the same flag so a disabled capability enqueues no new jobs.
WEMAIL_REPLY_DECISION_ENABLED=0
