+    async def edit_message(
+        self,
+        chat_id: str,
+        message_id: str,
+        content: str,
+        *,
+        finalize: bool = False,
+    ) -> SendResult:
+        """Replace a reply-mode stream frame and optionally finalize it."""
+        del chat_id
+        reply_req_id = self._stream_reply_req_ids.get(message_id)
+        if not reply_req_id:
+            return SendResult(success=False, error="WeCom stream context is unavailable")
+        try:
+            response = await self._send_reply_stream(
+                reply_req_id,
+                message_id,
+                content[:self.MAX_MESSAGE_LENGTH],
+                finish=finalize,
+            )
+        except asyncio.TimeoutError:
+            return SendResult(success=False, error="Timeout updating WeCom stream")
+        except Exception as exc:
+            logger.error("[%s] Stream update failed: %s", self.name, exc)
+            return SendResult(success=False, error=str(exc))
+        if finalize:
+            self._stream_reply_req_ids.pop(message_id, None)
+        return SendResult(success=True, message_id=message_id, raw_response=response)
