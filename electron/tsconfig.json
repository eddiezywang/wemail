{
  "extends": "../config/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "../dist-electron",
    "rootDir": "..",
    "types": ["node", "electron"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": false,
    "composite": false
  },
  "include": ["./**/*.ts", "../server/**/*.ts", "../shared/**/*.ts"]
}
